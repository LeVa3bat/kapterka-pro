// NEXT-SAFE PREVIEW ONLY — DO NOT DEPLOY until backend live checks pass.
//
// Goal: privileged license/global-registry collections become server-only.
// Existing direct unit synchronization is intentionally left compatible here
// because the current app does not use Firebase Auth for unit data yet.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Server service-account only. Client SDK access is denied.
    match /licenses/{licenseId} {
      allow read, write: if false;
    }

    // Server service-account only. Ordinary profile lookup/upsert and all
    // global admin reads are routed through the trusted backend.
    match /fighters/{fighterId} {
      allow read, write: if false;
    }

    // Direct multi-device sync remains unchanged for this migration stage.
    // These permissions MUST be reconciled with the currently deployed rules
    // before this file is ever published.
    match /units/{unitKey} {
      // Existing clients know the unit key and address that document directly.
      // Keep direct get/write compatibility, but do not allow enumerating all
      // unit root documents from an unauthenticated client.
      allow get, create, update, delete: if true;
      allow list: if false;

      // Explicit legacy/new sync surfaces. Avoid a recursive wildcard here:
      // in rules v2 it can also match the unit root and would defeat list denial.
      match /warehouse_points/{docId} {
        allow read, write: if true;
      }
      match /inventory_items/{docId} {
        allow read, write: if true;
      }
      match /stock_records/{docId} {
        allow read, write: if true;
      }
      match /operation_records/{docId} {
        allow read, write: if true;
      }
      match /requisitions/{docId} {
        allow read, write: if true;
      }
      match /devices/{docId} {
        allow read, write: if true;
      }
      match /sync_tombstones/{docId} {
        allow read, write: if true;
      }
    }

    // Deny anything not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
