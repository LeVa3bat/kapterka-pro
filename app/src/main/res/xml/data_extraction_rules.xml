<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Room/user/license data remains eligible for normal Android backup.
             Device UUID is ephemeral and must be regenerated after restore. -->
        <exclude domain="sharedpref" path="kapterka_sync_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="kapterka_sync_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
