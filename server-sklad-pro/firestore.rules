rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedUser() {
      return request.auth != null &&
        request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return verifiedUser() && request.auth.uid == uid;
    }

    function isPersonalOwner(workspaceId) {
      return verifiedUser() && workspaceId == request.auth.uid;
    }

    function memberPath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid);
    }

    function isMember(workspaceId) {
      return verifiedUser() && exists(memberPath(workspaceId));
    }

    function canReadWorkspace(workspaceId) {
      return isPersonalOwner(workspaceId) || isMember(workspaceId);
    }

    function memberRole(workspaceId) {
      return get(memberPath(workspaceId)).data.role;
    }

    function isManager(workspaceId) {
      return isPersonalOwner(workspaceId) ||
        (isMember(workspaceId) &&
          (memberRole(workspaceId) == 'owner' || memberRole(workspaceId) == 'manager'));
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isSelf(uid) &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /entitlements/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if verifiedUser() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /workspaces/{workspaceId} {
      allow read: if canReadWorkspace(workspaceId);
      allow create: if isPersonalOwner(workspaceId) &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update: if isPersonalOwner(workspaceId) &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;

      match /members/{uid} {
        allow read: if canReadWorkspace(workspaceId);
        allow create: if isPersonalOwner(workspaceId) &&
          uid == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.role == 'owner';
        allow update, delete: if false;
      }

      match /warehouses/{warehouseId} {
        allow read: if canReadWorkspace(workspaceId);
        allow create, update: if isManager(workspaceId);
        allow delete: if false;
      }

      match /items/{itemId} {
        allow read: if canReadWorkspace(workspaceId);
        allow create, update: if isManager(workspaceId);
        allow delete: if false;
      }

      match /stocks/{stockId} {
        allow read: if canReadWorkspace(workspaceId);
        allow create, update: if isManager(workspaceId);
        allow delete: if false;
      }

      match /operations/{operationId} {
        allow read: if canReadWorkspace(workspaceId);
        allow create: if isManager(workspaceId) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }

      match /requisitions/{requestId} {
        allow read: if canReadWorkspace(workspaceId);
        allow create: if isManager(workspaceId) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isManager(workspaceId) &&
          request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if false;
      }

      match /tombstones/{tombstoneId} {
        allow read: if canReadWorkspace(workspaceId);
        allow create, update: if isManager(workspaceId);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
